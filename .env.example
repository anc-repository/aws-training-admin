# ============================================================
# 環境変数サンプル
#   ローカル開発: このファイルを .env にコピーして編集
#   EC2 本番   : /etc/aws-training/app.env に配置（systemd が読み込む）
# ============================================================

# アプリケーション
PORT=3000
NODE_ENV=development
# セッション署名用の秘密鍵（本番では必ずランダムな長い文字列に変更）
SESSION_SECRET=change-me-to-a-long-random-string

# デプロイ方式（ダッシュボードに表示されます）
#   cloudformation / manual-ec2 / cicd-codepipeline / cicd-github-actions / local
DEPLOY_METHOD=local

# データベース（RDS for PostgreSQL のエンドポイントを指定）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=aws_training
# RDS for PostgreSQL 15 以降は SSL 必須のため、RDS 接続時は true にする
DB_SSL=false
# RDS の CA 証明書バンドルのパス（指定すると証明書検証を行う。推奨）
#   https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_CA=

# 初期管理者アカウント（npm run db:init 実行時に作成）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# 起動時にテーブル作成・初期データ投入を自動実行する場合は true
AUTO_MIGRATE=false
