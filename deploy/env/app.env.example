# ============================================================
# /etc/aws-training/app.env （EC2 上の本番用環境変数ファイル）
#   作成後: sudo chown root:nodeapp /etc/aws-training/app.env && sudo chmod 640 /etc/aws-training/app.env
#   ※ 値に空白・引用符・$ を含めないでください
# ============================================================
PORT=3000
NODE_ENV=production
# openssl rand -hex 32 で生成した値を設定
SESSION_SECRET=
# 方式に応じて変更: cloudformation / manual-ec2 / cicd-codepipeline / cicd-github-actions
DEPLOY_METHOD=manual-ec2

# RDS for PostgreSQL の接続情報
DB_HOST=xxxxxxxx.xxxxxxxxxxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=dbadmin
DB_PASSWORD=
DB_NAME=aws_training
DB_SSL=true
DB_SSL_CA=/etc/aws-training/rds-ca.pem

# 初期管理者（初回の npm run db:init で作成）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
